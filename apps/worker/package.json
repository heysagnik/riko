{
  "name": "@riko/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "start:prod": "tsx src/index.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.37",
    "@riko/agent": "workspace:*",
    "@riko/core": "workspace:*",
    "@riko/db": "workspace:*",
    "@riko/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^9.0.5",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./run": "./src/run.ts",
    "./mailer": "./src/lib/mailer.ts",
    "./rate-limiter": "./src/lib/rate-limiter.ts",
    "./logger": "./src/lib/logger.ts",
    "./pay-link": "./src/lib/pay-link.ts"
  }
}
