{
  "name": "@riko/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "start:prod": "tsx src/server.ts"
  },
  "dependencies": {
    "@riko/agent": "workspace:*",
    "@riko/core": "workspace:*",
    "@riko/db": "workspace:*",
    "@riko/shared": "workspace:*",
    "@riko/worker": "workspace:*",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  }
}
