{
  "name": "@riko/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "start:prod": "tsx src/server.ts"
  },
  "dependencies": {
    "@riko/agent": "workspace:*",
    "@riko/core": "workspace:*",
    "@riko/db": "workspace:*",
    "@riko/shared": "workspace:*",
    "@riko/worker": "workspace:*",
    "better-auth": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "tsx": "^4.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/express-serve-static-core": "^4.19.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
