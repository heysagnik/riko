DATABASE_URL=
APP_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000
APP_BASE_URL=http://localhost:5173

NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

INBOUND_MAIL_SECRET=

PORT=4000

# Percentage of cases held back uncontacted, as the control group for lift.
HOLDOUT_PERCENT=25

# The first email in a case goes out whenever it becomes due. Follow-ups hold
# to 7:00-23:00 in the customer's own timezone; this zone is the fallback for
# customers with no timezone of their own.
DEFAULT_CUSTOMER_TIMEZONE=Asia/Kolkata

# Pauses a tenant's outreach when opt-outs per send exceed this in 24h.
UNSUBSCRIBE_RATE_LIMIT=0.1

# Marginal cost of one recovery email, in minor units. Drives net-recovered.
COST_PER_SEND_MINOR=0

# Base address replies are collected on, shared by every tenant. Riko appends
# the per-case tag: billing+<case-id>@reply.example.com. The domain must be the
# one Email Routing catch-alls into the worker, not a merchant's own domain.
INBOUND_REPLY_BASE=billing@reply.example.com
