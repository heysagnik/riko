{
  "name": "riko",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "build": "pnpm --filter @riko/web run build && pnpm --filter @riko/db exec tsx src/migrate.ts",
    "start": "pnpm --filter @riko/api run start:prod",
    "dev": "pnpm -r --parallel --if-present run dev",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "db:generate": "pnpm --filter @riko/db run db:generate",
    "db:migrate": "pnpm --filter @riko/db run db:migrate"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@cloudflare/workers-types": "^5.20260825.1",
    "typescript": "^7.0.2"
  }
}
